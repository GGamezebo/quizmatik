; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Jet Math"
config/name_localized={
"ru": "Улётная математика"
}
config/version="0.1.0"
run/main_scene="uid://ddo0h56tnwsk1"
config/use_custom_user_dir=true
config/custom_user_dir_name="quizmatic"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.953, 0.902, 0.784, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://assets/app_icon/splash.png"
config/icon="res://assets/app_icon/icon_512.png"

[audio]

buses/default_bus_layout="uid://dhqwa53ij6mjm"
driver/output_latency.web=150

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"
window/handheld/orientation=4

[dotnet]

project/assembly_name="quizmatic"

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotSavesAddon/plugin.cfg", "res://addons/github_copilot/plugin.cfg", "res://addons/hfsm_editor/plugin.cfg", "res://addons/GodotGooglePlayBilling/plugin.cfg", "res://addons/godot_mcp/plugin.cfg")

[global]

Player=false
Projectile=false

[gui]

theme/custom="uid://bwi5l0b7v2vm4"

[importer_defaults]

texture={
"compress/channel_pack": 0,
"compress/hdr_compression": 1,
"compress/high_quality": false,
"compress/lossy_quality": 0.7,
"compress/mode": 2,
"compress/normal_map": 0,
"compress/rdo_quality_loss": 0.0,
"compress/uastc_level": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": false,
"mipmaps/limit": -1,
"process/fix_alpha_border": true,
"process/size_limit": 0
}

[input]

shoot={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":32,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[internationalization]

locale/translations=PackedStringArray("res://src/common/localization/translations.en.translation", "res://src/common/localization/translations.tr.translation", "res://src/common/localization/translations.es.translation", "res://src/common/localization/translations.pt.translation", "res://src/common/localization/translations.de.translation", "res://src/common/localization/translations.fr.translation", "res://src/common/localization/translations.it.translation", "res://src/common/localization/translations.pl.translation", "res://src/common/localization/translations.uk.translation", "res://src/common/localization/translations.id.translation", "res://src/common/localization/translations.nl.translation")
locale/fallback="ru"

[layer_names]

2d_render/layer_3="answers"
2d_physics/layer_1="player"
2d_physics/layer_2="shots"
2d_physics/layer_3="answers"

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true

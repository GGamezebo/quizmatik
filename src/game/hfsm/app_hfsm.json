{
	"App": {
		"scene": { "id": "app_root", "async_loading": false, "on_event": "ev.open_menu" },
		"states": {
			"Menu": {
				"scene": { "id": "menu", "loading_screen": true, "preload": ["game"] },
				"enter": ["ev.open_menu"],
				"leave": ["ev.start_game"],
			},
			"Tutorial": {
				"scene": { "id": "tutorial", "async_loading": false },
				"enter": ["ev.open_tutorial"],
				"leave": ["ev.close_tutorial"]
			},
			"ControlsIntro": {
				"scene": { "id": "controls_intro", "async_loading": false },
				"enter": ["ev.open_controls_intro"],
				"leave": ["ev.close_controls_intro"]
			},
			"Platform": {
				"context": "PlatformRouterContext",
				"enter": ["ev.open_platform"],
				"states": {
					"WEB": {
						"context": "WEBContext",
						"enter": ["ev.open_web"],
						"states": {
							"Yandex": {
								"context": "YandexContext",
								"enter": ["ev.open_yandex"],
								"states": {
									"YandexShop": { "context": "YandexShopContext", "enter": ["ev.open_shop"] },
									"YandexCloudSave": { "context": "YandexCloudSaveContext", "enter": ["ev.open_cloud_save"] }
								}
							},
							"CrazyGames": {
								"context": "CrazyGamesContext",
								"enter": ["ev.open_crazygames"],
								"states": {
									"CrazyGamesShop": { "context": "CrazyGamesShopContext", "enter": ["ev.open_shop"] },
									"CrazyGamesCloudSave": { "context": "CrazyGamesCloudSaveContext", "enter": ["ev.open_cloud_save"] }
								}
							},
							"Poki": {
								"context": "PokiContext",
								"enter": ["ev.open_poki"],
								"states": {
									"PokiShop": { "context": "PokiShopContext", "enter": ["ev.open_shop"] }
								}
							}
						}
					},
					"Android": {
						"context": "AndroidContext",
						"enter": ["ev.open_android"],
						"states": {
							"GooglePlay": {
								"context": "GooglePlayContext",
								"enter": ["ev.open_google_play"],
								"states": {
									"GooglePlayShop": { "context": "GooglePlayShopContext", "enter": ["ev.open_shop"] },
									"GooglePlayCloudSave": { "context": "GooglePlayCloudSaveContext", "enter": ["ev.open_cloud_save"] }
								}
							},
							"RuStore": {
								"context": "RuStoreContext",
								"enter": ["ev.open_rustore"],
								"states": {
									"RuStoreShop": { "context": "RuStoreShopContext", "enter": ["ev.open_shop"] }
								}
							},
							"AndroidDevShop": { "context": "DevShopContext", "enter": ["ev.open_dev_shop"] }
						}
					},
					"Desktop": {
						"context": "DesktopContext",
						"enter": ["ev.open_desktop"],
						"states": {
							"Steam": { "context": "SteamContext", "enter": ["ev.open_steam"] },
							"DevShop": { "context": "DevShopContext", "enter": ["ev.open_shop"] }
						}
					}
				}
			},
			"Battle": {
				"scene": { "id": "game", "loading_screen": true, "keep_loaded": true, "preload": ["post_battle"] },
				"enter": ["ev.start_game"],
				"leave": ["ev.open_post_battle", "ev.start_game"]
			},
			"PostBattle": {
				"scene": { "id": "post_battle", "loading_screen": true, "on_event": "ev.open_post_battle", "keep_loaded": true },
				"enter": ["ev.exit_game"],
				"leave": ["ev.open_menu", "ev.start_game"]
			},
			"Monetization": {
				"scene": { "id": "monetization", "async_loading": false },
				"enter": ["ev.open_monetization"]
			}
		}
	}
}

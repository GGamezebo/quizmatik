{
	"App": {
		"scene": { "id": "app_root", "loading_screen": true },
		"states": {
			"Menu": {
				"scene": { "id": "menu" },
				"enter": ["ev.open_menu"],
				"leave": ["ev.start_game"]
			},
			"Battle": {
				"scene": { "id": "game", "loading_screen": true },
				"enter": ["ev.start_game"],
				"leave": ["ev.exit_game"]
			},
			"PostBattle": {
				"scene": { "id": "post_battle" },
				"enter": ["ev.exit_game"],
				"leave": ["ev.open_menu", "ev.start_game"]
			}
		}
	}
}

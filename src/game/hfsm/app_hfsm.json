{
	"App": {
		"scene": { "id": "app_root", "async_loading": false, "on_event": "ev.open_menu" },
		"states": {
			"Menu": {
				"scene": { "id": "menu", "loading_screen": true, "preload": ["game"] },
				"enter": ["ev.open_menu"],
				"leave": ["ev.start_game"],
			},
			"Tutorial": {
				"scene": { "id": "tutorial", "async_loading": false },
				"enter": ["ev.open_tutorial"],
				"leave": ["ev.close_tutorial"]
			},
			"WEB": {
				"context": "WEBContext",
				"enter": ["ev.open_web"],
				"states": {
					"Yandex": {
						"context": "YandexContext",
						"enter": ["ev.open_yandex"]
					}
				}
			},
			"Battle": {
				"scene": { "id": "game", "loading_screen": true, "keep_loaded": true, "preload": ["post_battle"] },
				"enter": ["ev.start_game"],
				"leave": ["ev.open_post_battle", "ev.start_game"]
			},
			"PostBattle": {
				"scene": { "id": "post_battle", "on_event": "ev.open_post_battle", "keep_loaded": true },
				"enter": ["ev.exit_game"],
				"leave": ["ev.open_menu", "ev.start_game"]
			}
		}
	}
}
